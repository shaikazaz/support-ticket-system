{
  "info": {
    "name": "Support Ticket Management System",
    "description": "Covers registration/login, ticket CRUD, comments, and auth/authorization edge cases (401/403/404/400) for the Django REST Framework backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "agent_access_token", "value": "" },
    { "key": "ticket_id", "value": "" },
    { "key": "other_ticket_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newcustomer\",\n  \"first_name\": \"New\",\n  \"last_name\": \"Customer\",\n  \"email\": \"newcustomer@example.com\",\n  \"password\": \"StrongPass123\",\n  \"password_confirm\": \"StrongPass123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - success (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Customer123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Has access + refresh tokens', () => { pm.expect(data.access).to.exist; pm.expect(data.refresh).to.exist; });",
                  "pm.collectionVariables.set('access_token', data.access);",
                  "pm.collectionVariables.set('refresh_token', data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - success (agent)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.agent@example.com\",\n  \"password\": \"Agent123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('agent_access_token', data.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - invalid password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"WrongPassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket (customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/tickets/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Cannot access billing page\",\n  \"description\": \"The billing page returns a blank screen.\",\n  \"priority\": \"high\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('ticket_id', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create ticket - invalid input (short subject)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/tickets/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Hi\",\n  \"description\": \"desc\",\n  \"priority\": \"high\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
            }
          ]
        },
        {
          "name": "Get tickets (list) - authenticated",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/tickets/"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Get tickets - unauthorized (no token)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/tickets/"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "Get ticket by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/tickets/{{ticket_id}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Get ticket by ID - not found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/tickets/999999/"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"] }
            }
          ]
        },
        {
          "name": "Update ticket status (agent) - success",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agent_access_token}}" }
            ],
            "url": "{{base_url}}/tickets/{{ticket_id}}/",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Update ticket status (customer) - forbidden",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/tickets/{{ticket_id}}/",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"closed\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "Forbidden - customer creates ticket, agent tries to create one",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{agent_access_token}}" }
            ],
            "url": "{{base_url}}/tickets/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Agents should not create tickets\",\n  \"description\": \"desc\",\n  \"priority\": \"low\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 403 (wrong role)', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "Get comments for a ticket",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/tickets/{{ticket_id}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Add comment to ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/tickets/{{ticket_id}}/comments",
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Any update on this ticket?\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"] }
            }
          ]
        },
        {
          "name": "Agent stats dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agent_access_token}}" }],
            "url": "{{base_url}}/tickets/stats/"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "List agents (/api/users) - agent only",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agent_access_token}}" }],
            "url": "{{base_url}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "List agents (/api/users) - customer forbidden",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] }
            }
          ]
        }
      ]
    }
  ]
}
